# ==============================================================================
# Chikitsaalye Enterprise Digital Healthcare OS - Environment Configuration
# ==============================================================================
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# Copy this file to .env before starting the services locally.

# Node Environment
NODE_ENV=development
PORT=4000

# Application URLs
API_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
PATIENT_APP_URL=http://localhost:3001

# Hospital Organization Context
HOSPITAL_CODE=UPUMS-MAIN
HOSPITAL_NAME="Uttar Pradesh University of Medical Sciences (UPUMS) Hospital"
FACILITY_TIMEZONE="Asia/Kolkata"

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://chikitsaalye_user:chikitsaalye_password@localhost:5432/chikitsaalye_db?schema=public"
DATABASE_DIRECT_URL="postgresql://chikitsaalye_user:chikitsaalye_password@localhost:5432/chikitsaalye_db?schema=public"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# Cache & In-Memory Store (Redis 7)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="chikitsaalye:"
REDIS_DEFAULT_TTL_SEC=3600

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="chikitsaalye-dev-access-secret-replace-in-production-min-32-chars-long"
JWT_REFRESH_SECRET="chikitsaalye-dev-refresh-secret-replace-in-production-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
SESSION_COOKIE_NAME="chikitsaalye_session"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# ------------------------------------------------------------------------------
# Storage Configuration (Local / MinIO / S3)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local # 'local' | 's3' | 'minio'
STORAGE_LOCAL_PATH="./storage"
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET="chikitsaalye-records"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# Messaging & Notifications (SMS / Email / Push / Queue)
# ------------------------------------------------------------------------------
SMS_PROVIDER="mock" # 'mock' | 'nic_sms' | 'twillio'
SMS_API_KEY=""
EMAIL_SMTP_HOST="localhost"
EMAIL_SMTP_PORT=1025
EMAIL_FROM="noreply@chikitsaalye.upums.ac.in"

# ------------------------------------------------------------------------------
# Healthcare Integrations & Standards (ABDM / Ayushman Bharat)
# ------------------------------------------------------------------------------
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
ABDM_ENV="sandbox" # 'sandbox' | 'production'
ABDM_BRIDGE_URL="https://dev.abdm.gov.in"
DICOM_PACS_SERVER_URL=""
HL7_FHIR_BASE_URL="http://localhost:4000/api/v1/integrations/fhir"

# ------------------------------------------------------------------------------
# Observability & Logging
# ------------------------------------------------------------------------------
LOG_LEVEL="info" # 'debug' | 'info' | 'warn' | 'error'
AUDIT_LOG_ENABLED=true
ENABLE_QUERY_LOGGING=false
