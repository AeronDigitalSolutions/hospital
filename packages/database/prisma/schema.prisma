// ==============================================================================
// Chikitsaalye Database Schema - Core Architecture & Patient Master (CODEx-001 & CODEx-002)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// Hospital Organization / Facility
// ------------------------------------------------------------------------------
model HospitalOrganization {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. UPUMS-MAIN
  name        String
  legalName   String?
  address     String?
  phone       String?
  email       String?
  website     String?
  timezone    String   @default("Asia/Kolkata")
  currency    String   @default("INR")
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  patients    Patient[]

  @@map("hospital_organizations")
}

// ------------------------------------------------------------------------------
// User & Authentication Foundation
// ------------------------------------------------------------------------------
enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
  INACTIVE
}

model User {
  id                  String                @id @default(uuid())
  organizationId      String
  username            String                @unique
  email               String                @unique
  fullName            String
  passwordHash        String
  status              UserStatus            @default(ACTIVE)
  department          String?
  phone               String?
  designation         String?
  avatarUrl           String?
  patientId           String?
  failedLoginAttempts Int                   @default(0)
  lockoutUntil        DateTime?
  mfaEnabled          Boolean               @default(false)
  mfaSecret           String?
  lastLoginAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organization        HospitalOrganization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient             Patient?              @relation(fields: [patientId], references: [id], onDelete: SetNull)
  userRoles           UserRole[]
  sessions            Session[]
  auditEvents         AuditEvent[]

  // Attending Doctor relations
  attendingEncounters Encounter[]           @relation("AttendingDoctor")
  createdEncounters   Encounter[]           @relation("EncounterCreator")
  createdPatients     Patient[]             @relation("PatientCreator")

  @@index([organizationId])
  @@index([department])
  @@index([patientId])
  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique // e.g. SUPER_ADMIN, CLINICIAN
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g. patients:read, billing:write
  module      String           // e.g. patients, billing
  action      String           // e.g. read, write, dispense
  description String
  createdAt   DateTime         @default(now())

  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// ------------------------------------------------------------------------------
// Audit Trail Infrastructure
// ------------------------------------------------------------------------------
enum AuditActorType {
  USER
  SYSTEM
  PATIENT
  INTEGRATION
}

model AuditEvent {
  id         String         @id @default(uuid())
  actorId    String
  actorType  AuditActorType @default(USER)
  action     String         // e.g. PATIENT_READ, ENCOUNTER_CREATE
  resource   String         // e.g. Patient, Encounter
  resourceId String?
  requestId  String         // Correlation ID from HTTP request
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  timestamp  DateTime       @default(now())

  user       User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([requestId])
  @@index([timestamp])
  @@map("audit_events")
}

// ==============================================================================
// PATIENT MASTER FOUNDATION (CODEx-002)
// Canonical Master Patient Index (MPI) for the entire hospital ecosystem
// ==============================================================================

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DECEASED
  MERGED
}

model Patient {
  id                  String               @id @default(uuid())
  organizationId      String
  uhid                String               @unique // Canonical UHID e.g. UPUMS-2024-000001
  firstName           String
  middleName          String?
  lastName            String
  gender              Gender
  dateOfBirth         DateTime
  isEstimatedDob      Boolean              @default(false)
  bloodGroup          BloodGroup           @default(UNKNOWN)
  maritalStatus       MaritalStatus?
  nationality         String               @default("Indian")
  religion            String?
  occupation          String?
  photoUrl            String?
  status              PatientStatus        @default(ACTIVE)
  deceasedAt          DateTime?
  mergedIntoPatientId String?
  createdById         String?
  updatedById         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  // Organization & Creator References
  organization        HospitalOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator             User?                @relation("PatientCreator", fields: [createdById], references: [id], onDelete: SetNull)
  mergedInto          Patient?             @relation("PatientMergeHistory", fields: [mergedIntoPatientId], references: [id], onDelete: SetNull)
  mergedChildren      Patient[]            @relation("PatientMergeHistory")

  // Normalized Patient Components
  identifiers         PatientIdentifier[]
  contacts            PatientContact[]
  addresses           PatientAddress[]
  emergencyContacts   EmergencyContact[]
  insurances          PatientInsurance[]

  // Clinical Flags (Doctor Workspace Ready)
  allergies           PatientAllergy[]
  conditions          PatientCondition[]
  medications         PatientMedication[]
  consents            PatientConsent[]

  // Encounter Linkages
  encounters          Encounter[]

  // Linked User Accounts (for Patient Portal authentication)
  userAccounts        User[]

  @@index([organizationId])
  @@index([uhid])
  @@index([firstName, lastName])
  @@index([dateOfBirth])
  @@index([status])
  @@index([deletedAt])
  @@map("patients")
}

// ------------------------------------------------------------------------------
// Generic Patient Identifiers (ABHA, National ID, Passport, External Hospital ID)
// ------------------------------------------------------------------------------
enum IdentifierType {
  UHID
  ABHA_NUMBER
  ABHA_ADDRESS
  NATIONAL_ID
  PASSPORT
  VOTER_ID
  DRIVING_LICENSE
  EXTERNAL_HOSPITAL_ID
  OTHER
}

model PatientIdentifier {
  id               String         @id @default(uuid())
  patientId        String
  type             IdentifierType
  value            String
  issuingAuthority String?        // e.g. ABDM, UIDAI, UPUMS
  isPrimary        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  patient          Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([patientId])
  @@index([type, value])
  @@map("patient_identifiers")
}

// ------------------------------------------------------------------------------
// Normalized Contacts (Phone, Email)
// ------------------------------------------------------------------------------
enum ContactType {
  PHONE
  EMAIL
  LANDLINE
}

model PatientContact {
  id         String      @id @default(uuid())
  patientId  String
  type       ContactType @default(PHONE)
  value      String      // Phone or email
  isPrimary  Boolean     @default(true)
  isVerified Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([value])
  @@map("patient_contacts")
}

// ------------------------------------------------------------------------------
// Normalized Addresses
// ------------------------------------------------------------------------------
enum AddressType {
  CURRENT
  PERMANENT
  TEMPORARY
}

model PatientAddress {
  id           String      @id @default(uuid())
  patientId    String
  type         AddressType @default(CURRENT)
  addressLine1 String
  addressLine2 String?
  city         String
  district     String      // e.g. Etawah
  state        String      @default("Uttar Pradesh")
  postalCode   String
  country      String      @default("India")
  isPrimary    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  patient      Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([district, state])
  @@map("patient_addresses")
}

// ------------------------------------------------------------------------------
// Emergency Contacts
// ------------------------------------------------------------------------------
model EmergencyContact {
  id             String   @id @default(uuid())
  patientId      String
  name           String
  relationship   String   // e.g. Spouse, Father, Mother, Sibling, Guardian
  phone          String
  alternatePhone String?
  email          String?
  isPrimary      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("emergency_contacts")
}

// ------------------------------------------------------------------------------
// Patient Insurance / Schemes (PMJAY, CGHS, Private TPA)
// ------------------------------------------------------------------------------
enum PolicyType {
  PMJAY
  CGHS
  PRIVATE_TPA
  CORPORATE
  GOVERNMENT
  SELF
}

model PatientInsurance {
  id              String     @id @default(uuid())
  patientId       String
  policyNumber    String
  providerName    String     // e.g. Ayushman Bharat - PMJAY
  policyType      PolicyType @default(PMJAY)
  coverageDetails Json?
  validTill       DateTime?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  patient         Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([policyNumber])
  @@map("patient_insurances")
}

// ------------------------------------------------------------------------------
// Clinical Flags: Allergies
// ------------------------------------------------------------------------------
enum AllergenType {
  DRUG
  FOOD
  ENVIRONMENTAL
  BIOLOGICAL
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum AllergyStatus {
  ACTIVE
  RESOLVED
  SUSPECTED
}

model PatientAllergy {
  id           String          @id @default(uuid())
  patientId    String
  allergen     String
  allergenType AllergenType    @default(DRUG)
  severity     AllergySeverity @default(MODERATE)
  reaction     String?
  status       AllergyStatus   @default(ACTIVE)
  recordedAt   DateTime        @default(now())
  recordedById String?
  notes        String?

  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([patientId, status])
  @@map("patient_allergies")
}

// ------------------------------------------------------------------------------
// Clinical Flags: Chronic Conditions
// ------------------------------------------------------------------------------
enum ConditionClinicalStatus {
  ACTIVE
  RECURRENCE
  RELAPSE
  INACTIVE
  REMISSION
  RESOLVED
}

enum ConditionVerificationStatus {
  CONFIRMED
  PROVISIONAL
  DIFFERENTIAL
}

model PatientCondition {
  id                 String                      @id @default(uuid())
  patientId          String
  conditionCode      String?                     // ICD-10 e.g. E11.9
  conditionName      String                      // e.g. Type 2 Diabetes Mellitus
  clinicalStatus     ConditionClinicalStatus     @default(ACTIVE)
  verificationStatus ConditionVerificationStatus @default(CONFIRMED)
  onsetDate          DateTime?
  recordedAt         DateTime                    @default(now())
  recordedById       String?
  notes              String?

  patient            Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([patientId, clinicalStatus])
  @@map("patient_conditions")
}

// ------------------------------------------------------------------------------
// Clinical Flags: Medication History
// ------------------------------------------------------------------------------
enum MedicationStatus {
  ACTIVE
  DISCONTINUED
  COMPLETED
}

model PatientMedication {
  id           String           @id @default(uuid())
  patientId    String
  drugName     String
  dosage       String?
  frequency    String?
  route        String?          @default("ORAL")
  startDate    DateTime?
  endDate      DateTime?
  prescribedBy String?
  status       MedicationStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([patientId, status])
  @@map("patient_medications")
}

// ------------------------------------------------------------------------------
// Patient Consents (General Treatment, ABDM Data Sharing)
// ------------------------------------------------------------------------------
enum ConsentType {
  GENERAL_TREATMENT
  ABDM_DATA_SHARING
  PROCEDURE_SURGERY
  RESEARCH_USE
  BILLING_DISCLOSURE
}

enum ConsentStatus {
  GRANTED
  REVOKED
  EXPIRED
}

model PatientConsent {
  id            String        @id @default(uuid())
  patientId     String
  consentType   ConsentType   @default(GENERAL_TREATMENT)
  status        ConsentStatus @default(GRANTED)
  grantedAt     DateTime      @default(now())
  validUntil    DateTime?
  documentedBy  String?
  notes         String?

  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([patientId, consentType])
  @@map("patient_consents")
}

// ==============================================================================
// ENCOUNTER FOUNDATION (CODEx-002)
// Every clinical interaction creates a canonical Encounter referencing Patient
// ==============================================================================

enum EncounterType {
  OPD
  IPD
  EMERGENCY
  TELEMEDICINE
  FOLLOW_UP
  DAY_CARE
  PROCEDURE
  SURGERY
}

enum EncounterStatus {
  PLANNED
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EncounterPriority {
  ROUTINE
  URGENT
  EMERGENCY
}

model Encounter {
  id                 String            @id @default(uuid())
  encounterNumber    String            @unique // e.g. ENC-2024-000001
  patientId          String
  type               EncounterType     @default(OPD)
  status             EncounterStatus   @default(OPEN)
  priority           EncounterPriority @default(ROUTINE)
  department         String            // e.g. GENERAL_MEDICINE, CARDIOLOGY, EMERGENCY
  attendingDoctorId  String?
  startTime          DateTime          @default(now())
  endTime            DateTime?
  reasonForVisit     String            // Chief complaint
  metadata           Json?
  createdById        String?
  updatedById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  // Relationships
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  attendingDoctor    User?             @relation("AttendingDoctor", fields: [attendingDoctorId], references: [id], onDelete: SetNull)
  creator            User?             @relation("EncounterCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([encounterNumber])
  @@index([status])
  @@index([type])
  @@index([department])
  @@index([startTime])
  @@index([deletedAt])
  @@map("encounters")
}

// ==============================================================================
// MASTER DATA MANAGEMENT FOUNDATION (CODEx-004)
// Centralized taxonomies, facilities, clinical catalogues & tariffs
// ==============================================================================

enum DepartmentType {
  CLINICAL
  DIAGNOSTIC
  ADMINISTRATIVE
  SUPPORT
}

model Department {
  id                 String           @id @default(uuid())
  hospitalId         String           @default("UPUMS-MAIN")
  code               String           @unique // e.g. GEN_MED, GEN_SURG, RADIO
  name               String
  type               DepartmentType   @default(CLINICAL)
  description        String?
  headOfDepartmentId String?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  subdepartments     Subdepartment[]
  staffProfiles      StaffProfile[]
  doctorProfiles     DoctorProfile[]
  wards              Ward[]
  services           HospitalService[]
  investigations     InvestigationMaster[]
  procedures         ProcedureMaster[]

  @@index([hospitalId])
  @@index([type])
  @@index([isActive])
  @@map("departments")
}

model Subdepartment {
  id           String     @id @default(uuid())
  departmentId String
  code         String     @unique // e.g. NEPHRO, GASTRO
  name         String
  description  String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@map("subdepartments")
}

enum ProfessionalRole {
  DOCTOR
  NURSE
  LAB_TECHNICIAN
  RADIOLOGIST
  PHARMACIST
  ADMINISTRATIVE
  BILLING_OPERATOR
  OTHER
}

model StaffProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  staffCode        String           @unique // e.g. STF-00101
  departmentId     String
  subdepartmentId  String?
  professionalRole ProfessionalRole @default(DOCTOR)
  designation      String
  phone            String?
  email            String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  department       Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  doctorProfile    DoctorProfile?

  @@index([departmentId])
  @@index([professionalRole])
  @@map("staff_profiles")
}

model DoctorProfile {
  id                               String       @id @default(uuid())
  staffProfileId                   String       @unique
  departmentId                     String
  subdepartmentId                  String?
  medicalCouncilRegistrationNumber String       @unique // e.g. UP-MCI-48921
  specialization                   String
  qualifications                   String       // e.g. MBBS, MD (Medicine)
  opdRoomNumber                    String?
  consultationFee                  Decimal      @default(0.00) @db.Decimal(10, 2)
  isActive                         Boolean      @default(true)
  createdAt                        DateTime     @default(now())
  updatedAt                        DateTime     @updatedAt

  staffProfile                     StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  department                       Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([departmentId])
  @@index([specialization])
  @@map("doctor_profiles")
}

enum WardType {
  GENERAL
  ICU
  EMERGENCY
  PRIVATE
  SEMI_PRIVATE
  PEDIATRIC
  MATERNITY
  POST_OP
}

enum GenderAllowed {
  ALL
  MALE
  FEMALE
}

model Ward {
  id            String        @id @default(uuid())
  hospitalId    String        @default("UPUMS-MAIN")
  departmentId  String
  code          String        @unique // e.g. WARD-EMR, WARD-MMW
  name          String
  wardType      WardType      @default(GENERAL)
  floor         String?
  genderAllowed GenderAllowed @default(ALL)
  totalBeds     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  department    Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  rooms         Room[]
  beds          Bed[]

  @@index([departmentId])
  @@index([wardType])
  @@map("wards")
}

enum RoomType {
  GENERAL
  PRIVATE
  ISOLATION
  ICU_BAY
}

model Room {
  id           String    @id @default(uuid())
  wardId       String
  code         String    @unique // e.g. RM-101
  name         String
  roomType     RoomType  @default(GENERAL)
  maxOccupancy Int       @default(1)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ward         Ward      @relation(fields: [wardId], references: [id], onDelete: Cascade)
  beds         Bed[]

  @@index([wardId])
  @@map("rooms")
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  RESERVED
  MAINTENANCE
}

enum BedType {
  STANDARD
  ICU_VENTILATOR
  OXYGEN_SUPPORTED
  PEDIATRIC
  TRAUMA_BAY
}

model Bed {
  id        String    @id @default(uuid())
  wardId    String
  roomId    String
  code      String    @unique // e.g. BED-EMR-01
  name      String
  bedType   BedType   @default(STANDARD)
  status    BedStatus @default(AVAILABLE)
  dailyRate Decimal   @default(0.00) @db.Decimal(10, 2)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ward      Ward      @relation(fields: [wardId], references: [id], onDelete: Restrict)
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([wardId])
  @@index([roomId])
  @@index([status])
  @@map("beds")
}

enum ServiceCategory {
  CONSULTATION
  NURSING
  EMERGENCY
  PROCEDURE
  ICU
  GENERAL
}

model HospitalService {
  id           String          @id @default(uuid())
  code         String          @unique // e.g. SRV-OPD-GEN
  name         String
  description  String?
  departmentId String?
  category     ServiceCategory @default(GENERAL)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tariffs      TariffMaster[]

  @@index([category])
  @@index([departmentId])
  @@map("hospital_services")
}

enum InvestigationCategory {
  PATHOLOGY
  BIOCHEMISTRY
  MICROBIOLOGY
  HEMATOLOGY
  RADIOLOGY_XRAY
  RADIOLOGY_CT
  RADIOLOGY_MRI
  ULTRASOUND
  ECG
  OTHER
}

enum SpecimenSampleType {
  BLOOD
  URINE
  CSF
  TISSUE
  SPUTUM
  SWAB
  NOT_APPLICABLE
}

model InvestigationMaster {
  id              String                @id @default(uuid())
  code            String                @unique // e.g. INV-CBC, INV-CXR
  name            String
  category        InvestigationCategory @default(PATHOLOGY)
  sampleType      SpecimenSampleType    @default(NOT_APPLICABLE)
  departmentId    String?
  turnaroundHours Int                   @default(24)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  department      Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tariffs         TariffMaster[]

  @@index([category])
  @@index([departmentId])
  @@map("investigations_master")
}

enum DosageForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  OINTMENT
  DROPS
  INHALER
  IV_FLUID
  SUSPENSION
}

enum MedicineUnit {
  MG
  ML
  GM
  MCG
  IU
  PERCENT
}

model MedicineMaster {
  id                  String       @id @default(uuid())
  code                String       @unique // e.g. MED-PCM-500
  genericName         String
  brandName           String?
  dosageForm          DosageForm   @default(TABLET)
  strength            String       // e.g. "500"
  unit                MedicineUnit @default(MG)
  therapeuticCategory String?      // e.g. Analgesic, Antibiotic, Antidiabetic
  isHighAlert         Boolean      @default(false)
  isNarcotic          Boolean      @default(false)
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([genericName])
  @@index([dosageForm])
  @@map("medicines_master")
}

enum DiagnosisCodingSystem {
  ICD_10
  SNOMED_CT
  INSTITUTIONAL
}

model DiagnosisMaster {
  id           String                @id @default(uuid())
  code         String                @unique // e.g. E11.9, I10
  name         String
  codingSystem DiagnosisCodingSystem @default(ICD_10)
  category     String?
  isChronic    Boolean               @default(false)
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([code])
  @@index([codingSystem])
  @@map("diagnoses_master")
}

enum ProcedureCategory {
  MINOR_SURGERY
  MAJOR_SURGERY
  ENDOSCOPY
  CARDIAC_CATH
  BIOPSY
  PHYSIOTHERAPY
  DIALYSIS
  OTHER
}

model ProcedureMaster {
  id                     String            @id @default(uuid())
  code                   String            @unique // e.g. PROC-APP-01
  name                   String
  category               ProcedureCategory @default(OTHER)
  departmentId           String?
  typicalDurationMinutes Int               @default(60)
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  department             Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tariffs                TariffMaster[]

  @@index([category])
  @@index([departmentId])
  @@map("procedures_master")
}

enum TariffRateType {
  STANDARD
  PMJAY_SCHEME
  ECHS
  CGHS
  CORPORATE_INSURANCE
}

model TariffMaster {
  id              String               @id @default(uuid())
  code            String               @unique // e.g. TRF-CBC-STD, TRF-APP-PMJAY
  name            String
  serviceId       String?
  investigationId String?
  procedureId     String?
  rateType        TariffRateType       @default(STANDARD)
  standardPrice   Decimal              @default(0.00) @db.Decimal(10, 2)
  schemePrice     Decimal              @default(0.00) @db.Decimal(10, 2)
  effectiveFrom   DateTime             @default(now())
  effectiveTo     DateTime?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  service         HospitalService?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  investigation   InvestigationMaster? @relation(fields: [investigationId], references: [id], onDelete: SetNull)
  procedure       ProcedureMaster?     @relation(fields: [procedureId], references: [id], onDelete: SetNull)

  @@index([rateType])
  @@index([serviceId])
  @@index([investigationId])
  @@index([procedureId])
  @@map("tariffs_master")
}

model InsuranceProviderMaster {
  id            String   @id @default(uuid())
  code          String   @unique // e.g. INS-STAR, INS-ICICI
  name          String
  tpaName       String?
  contactPerson String?
  phone         String?
  email         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("insurance_providers_master")
}

model GovernmentSchemeMaster {
  id                 String   @id @default(uuid())
  code               String   @unique // e.g. SCH-PMJAY, SCH-ECHS
  name               String
  nodalAgency        String   // e.g. National Health Authority (NHA)
  coverageCap        Decimal? @db.Decimal(12, 2)
  discountPercentage Decimal? @db.Decimal(5, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("government_schemes_master")
}
